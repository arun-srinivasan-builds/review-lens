# LLM provider (only "openai" is supported initially)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-name
# Optional. Leave empty for the model default; some models reject non-default values.
OPENAI_TEMPERATURE=

# Upload and cost limits
MAX_UPLOAD_MB=10
MAX_ROWS=5000
MAX_REVIEW_CHARS=2000
MAX_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=60
MAX_RETRIES=2

# live = upload + OpenAI analysis; demo = pre-analysed data from demo_data/, no API calls
REVIEWLENS_MODE=live

# Live-site password for the Traefik basic-auth middleware (VPS only).
# Hash: docker run --rm -it caddy:2 caddy hash-password   (keep the single quotes)
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH='$2a$14$replace-with-your-bcrypt-hash'
